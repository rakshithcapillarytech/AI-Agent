# Copy to .env and fill in. Never commit .env.

# google (dev, free Gemini key) | anthropic (production target) | bedrock (post-MVP)
LLM_PROVIDER=google

# Gemini key from https://aistudio.google.com/apikey
# Free tier: Google may use prompts to improve its products. Use synthetic data only.
GOOGLE_API_KEY=

# Needed once LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Leave empty for provider defaults (app/llm.py):
#   google    → gemini-3.5-flash-lite / gemini-3.5-flash-lite  (gemini-3.8-flash is stronger but often 503s on the free tier)
#   anthropic → claude-opus-5-5 / claude-haiku-5-5
MAIN_MODEL=
HELPER_MODEL=

DATABASE_URL=postgresql://hydra:hydra@localhost:5432/hydra
API_BASE_URL=http://localhost:8000

# LangSmith tracing (optional for local dev). Redaction runs before anything is sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hydra-onboarding-agent
