# Copy to .env and fill in. Never commit .env.

# Only used by the evals and the optional chat assistant (PLAN.md §14); the kit needs no model.
# google (free Gemini key) | anthropic | bedrock (post-MVP)
LLM_PROVIDER=google

# Gemini key from https://aistudio.google.com/apikey (only for evals / the chat assistant)
# Free tier: Google may use prompts to improve its products. Use synthetic data only.
GOOGLE_API_KEY=

# Needed once LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Leave empty for provider defaults (app/llm.py):
#   google    → gemini-3.8-flash (falls back to gemini-3.5-flash-lite on errors) / gemini-3.5-flash-lite
#   anthropic → claude-opus-5-5 / claude-haiku-5-5
MAIN_MODEL=
HELPER_MODEL=

DATABASE_URL=postgresql://hydra:hydra@localhost:5432/hydra
API_BASE_URL=http://localhost:8000

# LangSmith tracing (optional for local dev). Redaction runs before anything is sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hydra-onboarding-agent
